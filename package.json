{
  "name": "web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && node scripts/open-dev-url.mjs http://localhost:3000\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-noveldex",
    "migrate:firestore": "tsx --env-file=.env.local scripts/one-off/migrate-postgres-to-firestore.ts",
    "backfill:event-locations": "tsx --env-file=.env.local scripts/one-off/backfill-event-locations.ts",
    "backfill:chapter-notes": "tsx --env-file=.env.local scripts/one-off/backfill-chapter-notes.ts",
    "backfill:chapter-entry-order": "tsx --env-file=.env.local scripts/one-off/backfill-chapter-entry-order.ts",
    "backfill:volume-chapter-numbers": "tsx --env-file=.env.local scripts/one-off/backfill-volume-chapter-numbers.ts",
    "backfill:entity-references": "tsx --env-file=.env.local scripts/one-off/backfill-entity-references.ts",
    "benchmark:search": "node --expose-gc --import tsx scripts/one-off/benchmark-search-index.ts",
    "dev:cloudflare": "vinext dev --port 3001",
    "build:cloudflare": "vinext build",
    "preview:cloudflare": "vinext build && wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv",
    "dev:vinext": "vinext dev --port 3001"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.7",
    "firebase": "^11.10.0",
    "minisearch": "^7.2.0",
    "next": "16.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@firebase/rules-unit-testing": "4.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^13",
    "open-cli": "^8.0.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^2",
    "wait-on": "^8.0.5",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "type": "module"
}
